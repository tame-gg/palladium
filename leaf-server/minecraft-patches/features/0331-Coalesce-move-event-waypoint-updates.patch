+                                    }
+                                    // Palladium end - Coalesce move event waypoint updates
                                     boolean isAutoSpinAttack = this.player.isAutoSpinAttack();
                                     this.clientIsFloating = verticalDelta >= -0.03125
                                         && !flag1
