From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: andrew <andrew@zandi.vip>
Date: Thu, 15 Oct 2026 02:40:05 -0400
Subject: [PATCH] Coalesce move event waypoint updates

To fire PlayerMoveEvent, ServerGamePacketListenerImpl#handleMovePlayer
snaps the player back to the previous position so plugins observe the
"from" location, then snaps it to the new position again. Each of those
position changes runs the locator bar hook in Entity#setPosRaw, which
walks every other player in the level (updateWaypoint + updatePlayer)
and, on block crossings, sends every receiver a waypoint update for the
new position, then the old one, then the new one again.

Defer the waypoint hook while that window is open and flush it once, in
a finally block, at whatever position the player ends up at (including
plugin teleports and cancelled moves). Receivers get the same final
waypoint state with a single update, and the two extra O(players)
passes per moving packet are replaced by one.

Controlled by performance.coalesce-move-waypoint-updates (default true)
in palladium-global.yml; false restores the per-step updates.

diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index 411fa06f43ddb5e0d804a28587bfa5335c1e3a81..ae0d02e3e6d6a62c14f107b6b1b7de848dc9a584 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -432,6 +432,10 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
     public boolean suppressTrackerForLogin = false; // Paper - Fire PlayerJoinEvent when Player is actually ready
     // CraftBukkit end
     public boolean didPlayerJoinEvent = false; // Gale - EMC - do not process chat/commands before player has joined
+    // Palladium start - Coalesce move event waypoint updates
+    public boolean deferWaypointUpdates;
+    public boolean deferredWaypointUpdate;
+    // Palladium end - Coalesce move event waypoint updates
     public boolean isRealPlayer; // Paper
     public com.destroystokyo.paper.event.entity.@Nullable PlayerNaturallySpawnCreaturesEvent playerNaturallySpawnedEvent; // Paper - PlayerNaturallySpawnCreaturesEvent
     public org.bukkit.event.player.PlayerQuitEvent.@Nullable QuitReason quitReason = null; // Paper - Add API for quit reason; there are a lot of changes to do if we change all methods leading to the event
@@ -1475,6 +1479,26 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         return this.getAttributeValue(Attributes.WAYPOINT_RECEIVE_RANGE) > 0.0;
     }
 
+    // Palladium start - Coalesce move event waypoint updates
+    public void flushDeferredWaypointUpdates() {
+        this.deferWaypointUpdates = false;
+        if (!this.deferredWaypointUpdate) {
+            return;
+        }
+        this.deferredWaypointUpdate = false;
+        // Same conditions as the waypoint hook in Entity#setPosRaw, evaluated once at the final position
+        if (!this.firstTick && !this.isRemoved()) {
+            ServerWaypointManager waypointManager = this.level().getWaypointManager();
+            if (this.isTransmittingWaypoint()) {
+                waypointManager.updateWaypoint(this);
+            }
+            if (this.isReceivingWaypoints() && this.connection != null) {
+                waypointManager.updatePlayer(this);
+            }
+        }
+    }
+    // Palladium end - Coalesce move event waypoint updates
+
     @Override
     protected void onAttributeUpdated(Holder<Attribute> attribute) {
         if (attribute.is(Attributes.WAYPOINT_RECEIVE_RANGE)) {
